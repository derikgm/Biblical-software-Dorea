{
  "name": "dorea",
  "version": "0.1.0",
  "description": "App de escritorio de lectura bíblica y notas (Angular 20 + Tauri 2 + Rust).",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "check": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "lint:fix": "eslint \"src/**/*.{ts,html}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,json}\"",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings"
  },
  "dependencies": {
    "@angular/common": "^20.1.4",
    "@angular/compiler": "^20.1.4",
    "@angular/core": "^20.1.4",
    "@angular/forms": "^20.1.4",
    "@angular/platform-browser": "^20.1.4",
    "@angular/router": "^20.1.4",
    "@ng-icons/coolicons": "^34.0.0",
    "@ng-icons/core": "^32.5.0",
    "@ng-icons/heroicons": "^32.5.0",
    "@ng-icons/material-file-icons": "^34.0.0",
    "@ng-icons/material-icons": "^34.0.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.1.4",
    "@angular/cli": "^20.1.4",
    "@angular/compiler-cli": "^20.1.4",
    "@eslint/js": "^9",
    "@tauri-apps/cli": "^2",
    "angular-eslint": "^20",
    "autoprefixer": "^10.5.2",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "postcss": "^8.5.16",
    "prettier": "^3",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8"
  }
}